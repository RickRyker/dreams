{
  "name": "server",
  "version": "1.0.0",
  "description": "server for the Dreams of Nowhere Else and Beyond application",
  "keywords": [
    "server",
    "node",
    "express",
    "prisma",
    "authentication",
    "api"
  ],
  "author": "Richard Thomas Ryker",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "_moduleAliases": {
    "@shared": "shared"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsc-alias -p tsconfig.json",
    "clean": "rimraf dist",
    "dev": "tsx watch --tsconfig ./tsconfig.json src/index.ts",
    "lint": "eslint src",
    "watch": "tsc -b -w",
    "prisma:build": "node ./prisma/build.js && prisma format",
    "prisma:generate": "npm run prisma:build && prisma generate",
    "prisma:migrate": "npm run prisma:generate && prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:deploy": "prisma migrate deploy",
    "start": "node dist/index.js",
    "test": "jest",
    "test:accounts": "jest test/accounts",
    "test:layers": "jest test/utils/discoverLayerFiles.test.ts test/accounts/accounts.layers.test.ts test/players/players.layers.test.ts test/combat/combat.layers.test.ts",
    "test:players": "jest test/players",
    "test:watch": "jest --watch"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/client-secrets-manager": "^3.1079.0",
    "@aws-sdk/client-sesv2": "^3.1079.0",
    "@aws-sdk/lib-storage": "^3.1079.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@quixo3/prisma-session-store": "^3.1.21",
    "axios": "1.18.1",
    "bad-words": "^4.0.0",
    "baseline-browser-mapping": "^2.10.32",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.0-rc.1",
    "browserslist": "^4.28.2",
    "bullmq": "^5.77.1",
    "caniuse-lite": "^1.0.30001793",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "electron-to-chromium": "^1.5.361",
    "escalade": "^3.2.0",
    "express-http-proxy": "1.6.3",
    "express-session": "^1.19.0",
    "fraction.js": "^5.3.4",
    "geoip-lite": "^2.0.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.11",
    "node-releases": "^2.0.46",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "path": "^0.12.7",
    "pg": "^8.21.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "postcss-value-parser": "^4.2.0",
    "prisma": "^7.8.0",
    "source-map-js": "^1.2.1",
    "string-similarity": "^4.0.4",
    "update-browserslist-db": "^1.0.10",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-http-proxy": "1.6.7",
    "@types/express-session": "^1.19.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-discord": "^0.1.15",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.20.0",
    "@types/string-similarity": "^4.0.2",
    "@types/supertest": "^7.2.0",
    "@types/winston": "^2.4.4",
    "@types/ws": "^8.18.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-prisma": "^1.0.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prisma-schema-auditor": "^1.2.1",
    "prisma-zod-generator": "^2.1.4",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "tsx": "4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "private": true
}

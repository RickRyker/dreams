{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@auth/*": ["src/auth/*"],
      "@core/*": ["src/core/*"],
      "@email/*": ["src/email/*"],
      "@prisma": ["src/db/client.ts"],
      "@shared/*": ["../shared/*"]
    },
    "ignoreDeprecations": "6.0", // for the baseUrl issue with tsconfig-paths
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "references": [
    { "path": "../shared" }
  ]
}

model MessageLog {
  id             String      @id @default(cuid())
  senderId       String? // Who sent it (character-based messaging)
  sender         Player?     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId    String? // Who received it (null for global/system messages)
  recipient      Player?     @relation("MessageRecipient", fields: [recipientId], references: [id])
  messageType    MessageType @default(SYSTEM)
  content        String
  isFlagged      Boolean     @default(false)
  isFiltered     Boolean     @default(false)
  badWords       Json // {[ 'bad-word1', 'bad-word2' ]}
  moderatorId    String?
  moderator      Player?     @relation("MessageModerator", fields: [moderatorId], references: [id])
  moderationNote String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}


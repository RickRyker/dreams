model ProfanityPattern {
  id        String   @id @default(cuid())
  pattern   String   @unique
  severity  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  playerRoles PlayerRole[] // bi-directional relationship
}

model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  permission String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WorldConfig {
  id        String               @id @default(cuid())
  name      String               @default("Dreams of Nowhere Else and Beyond")
  settings  WorldConfigSetting[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model WorldConfigSetting {
  id            String                 @id @default(cuid())
  worldConfigId String
  worldConfig   WorldConfig            @relation(fields: [worldConfigId], references: [id])
  name          WorldConfigSettingType
  value         String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([worldConfigId, name])
}

enum WorldConfigSettingType {
  BUFFER_SIZE
  MAINTENANCE_START
  LOG_SIZE_LIMIT_BYTES
  LOG_PRUNE_DAYS
  IS_MAINTENANCE_MODE
  BYPASS_MAINTENANCE
  SIMILARITY_THRESHOLD
  TUTORIAL_MAP
  TUTORIAL_START_X
  TUTORIAL_START_Y
  GHOST_DURATION_MINUTES
  MIN_LEVEL_CREATE_GUILD
  MIN_LEVEL_JOIN_GUILD
}

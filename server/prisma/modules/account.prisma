// ---------------------------------------
//  Session and Account Models
// ---------------------------------------

model Account {
  id                  String                  @id @default(cuid())
  email               String                  @unique
  passwordHash        String // encrypted with secret salt
  authentication      AccountAuthentication[]
  avatars             Avatar[]
  blockedBy           Player[]                @relation("BlockedAccounts")
  characters          Player[]
  devices             Device[]
  emailChangeTokens   EmailChangeToken[]
  mfaSecrets          MfaSecret[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[]
  refreshTokens       RefreshToken[]
  emailVerifiedAt     DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model AccountAuthentication {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  provider  String   @default("PASSWORD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, provider])
}

model Avatar {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  name          String
  description   String
  // spriteId             Int?            // reference to a sprite sheet entry
  // sprite               Sprite?         @relation("AvatarSprite", fields: [spriteId], references: [id])
  // iconId               Int?            // small icon for UI
  // icon                 Icon?           @relation("AvatarIcon", fields: [iconId], references: [id])
  s3Key         String //
  isApproved    Boolean  @default(false)
  isFree        Boolean  @default(false)
  creatorId     String
  creator       Player   @relation("CreatedAvatars", fields: [creatorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  activeAvatars Player[] // bi-directional relationship

  @@unique([accountId, name])
}

model Device {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  name      String
  lastIp    String
  trusted   Boolean  @default(false)
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([accountId, name])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  token     String   @unique
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  email     String // the email at the time of request; may be different from current email
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model MfaSecret {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id])
  secret    String // base32 TOTP secret
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model RateLimit {
  id        String   @id @default(cuid())
  ip        String
  endpoint  String
  timestamp DateTime @default(now())

  @@index([ip, endpoint, timestamp])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  email     String // the email at the time of sign up; may be different from current email
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

  auctionItems       Auction[]               @relation("AuctionSeller")
  combatParticipants CombatParticipant[]     @relation("CombatPlayer")
  containersOwned    Container[]             @relation("ContainerOwner")
  guildsFounded      Guild[]                 @relation("GuildFounder")
  guildLogs          GuildLog[]              @relation("GuildActionBy")
  receivedMessages   MessageLog[]            @relation("MessageRecipient")
  sentMessages       MessageLog[]            @relation("MessageSender")
  moderatedMessages  MessageLog[]            @relation("MessageModerator")
  moderatedNames     PlayerNameHistory[]     @relation("NameChangeModerator")
  blockedAccounts    Account[]               @relation("BlockedAccounts")
  blockedPlayers     BlockedPlayer[]         @relation("Blocker")
  blockedBy          BlockedPlayer[]         @relation("Blocked")
  createdAvatars     Avatar[]                @relation("CreatedAvatars")
  createEvents       Event[]                 @relation("CreatedEvents")
  createdItems       Item[]                  @relation("CreatedItems")
  createdMaps        Map[]                   @relation("CreatedMaps")
  createdQuests      Quest[]                 @relation("CreatedQuests")
  bannedPlayers      Ban[]                   @relation("Banned")
  mutedPlayers       Mute[]                  @relation("Muted")

  messageFilters     Json?                   @default("[]") // array of filter objects { type: "SPAM", pattern: "Buy gold at..." }
  hotbar             Json                    @default("[]") // array of slots
  keybinds           Json                    @default("{}") // action -> key
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

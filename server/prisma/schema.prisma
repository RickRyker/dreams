// ---------------------------------------
//  Quest Core
// ---------------------------------------

model Quest {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  requirementLevel Int      @default(0) // minimum level required to accept the quest
  createdById      String
  createdBy        Player   @relation("CreatedQuests", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // normalized requirements & rewards
  requirementItems  QuestRequirementItem[]
  requirementSkills QuestRequirementSkill[]
  requirementQuests QuestRequirementQuest[] @relation("QuestRequirementQuest_quest")
  rewardItems       QuestRewardItem[]
  rewardSkills      QuestRewardSkill[]
  rewardTitles      QuestRewardTitle[]
  dependencies      QuestDependency[]       @relation("QuestDependency_quest")
  // reverse dependency (quests that depend on this quest)
  dependedOnBy      QuestDependency[]       @relation("QuestDependency_dependsOn")
  // bi-directional relationships
  dialogConditions  DialogCondition[]
  playerQuests      PlayerQuest[]
  requiredByQuests  QuestRequirementQuest[] @relation("QuestRequirementQuest_required")
  requirementLevels QuestRequirementLevel[]

  @@index([slug])
  @@index([createdById])
}

enum QuestStatusType {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ---------------------------------------
//  Requirements
// ---------------------------------------

model QuestRequirementLevel {
  id      String @id @default(cuid())
  questId String
  quest   Quest  @relation(fields: [questId], references: [id])
  level   Int    @default(1)

  @@index([questId])
}

model QuestRequirementItem {
  id       String @id @default(cuid())
  questId  String
  quest    Quest  @relation(fields: [questId], references: [id])
  itemSlug String
  quantity Int    @default(1)

  @@index([questId])
  @@index([itemSlug])
}

model QuestRequirementSkill {
  id        String @id @default(cuid())
  questId   String
  quest     Quest  @relation(fields: [questId], references: [id])
  skillSlug String
  quantity  Int    @default(1)

  @@index([questId])
  @@index([skillSlug])
}

model QuestRequirementQuest {
  id              String @id @default(cuid())
  questId         String // quest that has the requirement
  quest           Quest  @relation("QuestRequirementQuest_quest", fields: [questId], references: [id])
  requiredQuestId String // quest that is required
  requiredQuest   Quest  @relation("QuestRequirementQuest_required", fields: [requiredQuestId], references: [id])

  @@index([questId])
  @@index([requiredQuestId])
}

// ---------------------------------------
//  Rewards
// ---------------------------------------

model QuestRewardItem {
  id       String @id @default(cuid())
  questId  String
  quest    Quest  @relation(fields: [questId], references: [id])
  itemSlug String
  quantity Int    @default(1)

  @@index([questId])
  @@index([itemSlug])
}

model QuestRewardSkill {
  id        String @id @default(cuid())
  questId   String
  quest     Quest  @relation(fields: [questId], references: [id])
  skillSlug String

  @@index([questId])
  @@index([skillSlug])
}

model QuestRewardTitle {
  id        String @id @default(cuid())
  questId   String
  quest     Quest  @relation(fields: [questId], references: [id])
  titleSlug String

  @@index([questId])
  @@index([titleSlug])
}

// ---------------------------------------
//  Quest Dependencies (global graph)
// ---------------------------------------

model QuestDependency {
  id             String @id @default(cuid())
  questId        String // quest that depends on another
  quest          Quest  @relation("QuestDependency_quest", fields: [questId], references: [id])
  dependsOn      String // quest that is depended on
  dependsOnQuest Quest  @relation("QuestDependency_dependsOn", fields: [dependsOn], references: [id])

  @@index([questId])
  @@index([dependsOn])
}

// ---------------------------------------
//  Region Module
// ---------------------------------------

enum BonusCategoryType {
  NONE // No (known) bonuses
  VITALITY //	Increases maximum health or health regeneration
  ENDURANCE //	Reduces stamina drain; increases stamina recovery rate
  FOCUS // Improves concentration, precision skills, or mana-related stats
  WARMTH // Resistance to cold environments and weather conditions
  HEAT_RESISTANCE // Resistance to fire and extreme heat environments
  FORTITUDE // Damage reduction; resistance to debuffs
  SPEED // Movement speed and reflex bonuses
  CHARISMA //	Improved trade prices; faction reputation gain
  RECOVERY // Shortens status effect durations; aids healing
  LUCK // Increases rare drop chance; critical success probability
}

enum IngredientRarityType {
  COMMON
  UNCOMMON
  RARE
  LEGENDARY
}

model Region {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  dishes      RegionalDish[] // signature dishes
  ingredients RegionalIngredient[] // unique gatherable ingredients (flowers, herbs, ores, woods, etc.)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  // bi-directional relationships
  maps        Map[]
}

model RegionalDish {
  id            String               @id @default(cuid())
  regionId      String
  region        Region               @relation(fields: [regionId], references: [id])
  dish          String // Item.slug
  rarity        IngredientRarityType @default(COMMON) // affects drop percentages
  bonuses       RegionalDishBonus[]
  bonusDuration Int                  @default(10) // minutes
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([regionId, dish])
  @@index([regionId])
  @@index([dish])
}

model RegionalDishBonus {
  id             String            @id @default(cuid())
  regionalDishId String
  regionalDish   RegionalDish      @relation(fields: [regionalDishId], references: [id])
  bonusCategory  BonusCategoryType @default(NONE)
  value          Int               @default(10)
  mythicBonus    Boolean           @default(false) // if true, only active if dish ingredients all legendary quality
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model RegionalIngredient {
  id         String               @id @default(cuid())
  regionId   String
  region     Region               @relation(fields: [regionId], references: [id])
  ingredient String // Item.slug
  rarity     IngredientRarityType @default(COMMON)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([regionId, ingredient])
}

// ---------------------------------------
//  Spell Related Enums and Models
// ---------------------------------------

model Spell {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String?
  // Requirements
  minLevel     Int           @default(0)
  // Classification
  element      ElementType   @default(NONE)
  skillSlug    String?
  attackType   AttackType    @default(MAGIC) // melee, ranged, magic, etc.
  // Core mechanics
  manaCost     Int           @default(0)
  cooldown     Int           @default(0) // milliseconds
  castTime     Int           @default(0) // milliseconds
  range        Int           @default(1)
  areaOfEffect Int           @default(0)
  // Damage / healing / effects stored as JSON:
  effect       Json // { baseDamage: 12, scaling: { stat: "int", ratio: 0.4 }, status: "burn" }
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  playerSpells PlayerSpell[] // bi-directional relationship
}


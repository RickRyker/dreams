{
  "name": "dreams-of-nowhere-else-and-beyond-monorepo",
  "description": "Dreams of Nowhere Else and Beyond",
  "author": "Richard Thomas Ryker",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "client/",
    "infrastructure/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "validate:tsconfig": "ts-node scripts/validate-tsconfig.ts",
    "heal:alias": "ts-node tools/heal-shared-alias.cjs",
    "prisma:build": "npm run prisma:build -w server",
    "prisma:generate": "npm run prisma:generate -w server && npm run prebuild",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:seed": "npm run prisma:seed -w server",
    "schema:diff": "ts-node tools/prisma_schema_diff.ts server/prisma/schema.prisma server/prisma/schema-mysql.prisma",
    "schema:convert:mysql": "ts-node tools/convert_neon_to_aurora.cjs",
    "tools:check": "npm run schema:diff",
    "ci:prisma": "npm run tools:check && npm run prisma:validate -w server",
    "codegen": "npm run codegen:dtos && npm run codegen:index && npm run codegen:structure",
    "codegen:dtos": "node tools/generate-dtos.cjs",
    "codegen:index": "node tools/generate-shared-index.cjs",
    "codegen:structure": "node tools/generate-structure/index.cjs -f tree -o DIRECTORY_STRUCTURE.md -d 9 -r .",
    "prebuild": "npm run codegen",
    "build": "npm run build:shared && npm run build:server && npm run build:client && npm run build:infra",
    "build:shared": "npm --workspace shared run build",
    "build:server": "npm --workspace server run build",
    "build:client": "npm --workspace client run build",
    "build:infra": "npm --workspace infrastructure run build",
    "cdk:boottrap": "cdk boottrap",
    "cdk:diff": "cdk diff",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy --all",
    "clean": "npm run clean:shared && npm run clean:server && npm run clean:client && npm run clean:infra",
    "clean:shared": "npm --workspace shared run clean",
    "clean:server": "npm --workspace server run clean",
    "clean:client": "npm --workspace client run clean",
    "clean:infra": "npm --workspace infrastructure run clean",
    "lint": "npm run lint -w server && npm run lint -w client",
    "watch": "npm run watch:shared & npm run watch:server & npm run watch:client",
    "watch:shared": "npm --workspace shared run watch",
    "watch:server": "npm --workspace server run watch",
    "watch:client": "npm --workspace client run watch",
    "dev": "concurrently -n shared,server,client -c cyan,magenta,green \"npm:dev:shared\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:shared": "npm --workspace shared run watch",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1079.0",
    "@aws-sdk/client-sqs": "^3.1079.0",
    "glob": "^13.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
